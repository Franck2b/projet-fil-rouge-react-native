# Supabase → Project Settings → API Keys
# La « publishable key » (sb_publishable_…) est faite pour être embarquée dans un
# client : c'est la RLS qui protège les données. Aucune clé secrète ici.
EXPO_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
